{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "brand/uptime-lounge-web": false,
      "chore/quality-gate-and-vercel-discipline": false,
      "feature/demo-community-seed-20260826": false,
      "finish-root-social": false,
      "prod-foundation-20260825": false,
      "release/root-lounge-live-billing-20260903": false,
      "release/root-mobile-v1": false,
      "wire-root-production-supabase": false,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {"key":"Link","value":"<https://www.uptimelounge.com/>; rel=\"canonical\""},
        {"key":"X-Robots-Tag","value":"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.stripe.com\")"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com; img-src 'self' data:; font-src 'self'; frame-src https://checkout.stripe.com; form-action 'self' https://checkout.stripe.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"no-store"},
        {"key":"X-Robots-Tag","value":"noindex, nofollow"}
      ]
    }
  ]
}
